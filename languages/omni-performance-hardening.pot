#. Plugin Name of the plugin
#: omni-performance-hardening.php
#: omni-performance-hardening.php:738
#: omni-performance-hardening.php:739
#: omni-performance-hardening.php:813
msgid "Omni Performance Hardening"
msgstr ""

#. Plugin URI of the plugin
#: omni-performance-hardening.php
msgid "https://github.com/ivanusto/omni-wp-perf-hardening"
msgstr ""

#. Description of the plugin
#: omni-performance-hardening.php
msgid "Tames the most expensive WordPress endpoints: search table scans, archive SQL_CALC_FOUND_ROWS, low-value feeds, oEmbed and XML-RPC, with CDN-friendly cache headers."
msgstr ""

#. Author of the plugin
#: omni-performance-hardening.php
msgid "ivanusto"
msgstr ""

#. Author URI of the plugin
#: omni-performance-hardening.php
msgid "https://github.com/ivanusto"
msgstr ""

#: omni-performance-hardening.php:695
msgid "Feature switches"
msgstr ""

#: omni-performance-hardening.php:696
msgid "Search hardening"
msgstr ""

#: omni-performance-hardening.php:696
msgid "Filter junk search probes and narrow the query scope"
msgstr ""

#: omni-performance-hardening.php:697
msgid "Archive query slimming"
msgstr ""

#: omni-performance-hardening.php:697
msgid "Drop SQL_CALC_FOUND_ROWS on tag, author and date archives"
msgstr ""

#: omni-performance-hardening.php:698
msgid "Skip counts on widget queries"
msgstr ""

#: omni-performance-hardening.php:698
msgid "Drops SQL_CALC_FOUND_ROWS on sidebar, related-post and page-builder queries. Off by default: it sets found_posts to 0, and themes or page builders that read that value — Elementor post widgets, custom pagination — will render an empty list. Turn it on, then check that every post listing on your site still appears"
msgstr ""

#: omni-performance-hardening.php:699
msgid "Cache & robots headers"
msgstr ""

#: omni-performance-hardening.php:699
msgid "Send Cache-Control and X-Robots-Tag per endpoint type for feeds, search, tag pages and 404s"
msgstr ""

#: omni-performance-hardening.php:700
msgid "Author page hardening"
msgstr ""

#: omni-performance-hardening.php:700
msgid "Author pages get noindex, author feeds return 410 and robots.txt blocks /author/. Off by default; enable it only on sites that do not want author archives in search results"
msgstr ""

#: omni-performance-hardening.php:701
msgid "Heartbeat tuning"
msgstr ""

#: omni-performance-hardening.php:701
msgid "Slow down admin polling and disable the frontend Heartbeat"
msgstr ""

#: omni-performance-hardening.php:702
msgid "Disable external oEmbed discovery"
msgstr ""

#: omni-performance-hardening.php:702
msgid "Stops WordPress from probing arbitrary URLs for an oEmbed endpoint when a link is pasted. Providers on the built-in list — YouTube, X, Vimeo and the rest — still embed normally"
msgstr ""

#: omni-performance-hardening.php:703
msgid "Disable oEmbed endpoints and /embed/ routes"
msgstr ""

#: omni-performance-hardening.php:703
msgid "Removes this site's own oEmbed REST endpoint, its discovery links and the /embed/ pages. Off by default: WordPress needs all three to turn a pasted link to your own post into an embed card, so enabling this leaves those embeds as plain links. Crawl load on /embed/ is already handled with noindex and a long CDN cache. Rewrite rules rebuild automatically after toggling"
msgstr ""

#: omni-performance-hardening.php:704
msgid "Disable XML-RPC"
msgstr ""

#: omni-performance-hardening.php:704
msgid "Including pingback"
msgstr ""

#: omni-performance-hardening.php:705
msgid "Frontend external request throttle"
msgstr ""

#: omni-performance-hardening.php:705
msgid "Cap external HTTP timeouts on frontend requests from logged-out visitors"
msgstr ""

#: omni-performance-hardening.php:706
msgid "Manage robots.txt"
msgstr ""

#: omni-performance-hardening.php:706
msgid "Only takes effect when no physical robots.txt exists in the site root"
msgstr ""

#: omni-performance-hardening.php:707
msgid "Block REST user enumeration"
msgstr ""

#: omni-performance-hardening.php:707
msgid "Logged-out visitors cannot access /wp/v2/users"
msgstr ""

#: omni-performance-hardening.php:708
msgid "Remove news dashboard widgets"
msgstr ""

#: omni-performance-hardening.php:708
msgid "Removes the WordPress Events and News widget, and the W3 Total Cache news widget if present. These fetch remote data every time the dashboard loads"
msgstr ""

#: omni-performance-hardening.php:710
msgid "Search"
msgstr ""

#: omni-performance-hardening.php:711
msgid "Minimum keyword length"
msgstr ""

#: omni-performance-hardening.php:711
msgid "Shorter keywords are rejected before any query runs. Counted in characters, so two-character CJK words still pass"
msgstr ""

#: omni-performance-hardening.php:712
msgid "Maximum keyword length"
msgstr ""

#: omni-performance-hardening.php:712
msgid "Longer keywords are treated as junk probes and rejected"
msgstr ""

#: omni-performance-hardening.php:713
msgid "Word count limit"
msgstr ""

#: omni-performance-hardening.php:713
msgid "Whitespace-separated words; 0 disables"
msgstr ""

#: omni-performance-hardening.php:714
msgid "Result pages limit"
msgstr ""

#: omni-performance-hardening.php:714
msgid "0 disables"
msgstr ""

#: omni-performance-hardening.php:715
msgid "Results per page"
msgstr ""

#: omni-performance-hardening.php:715
msgid "Search results page only; archives have their own setting below. Minimum 1"
msgstr ""

#: omni-performance-hardening.php:716
msgid "Match titles and excerpts only"
msgstr ""

#: omni-performance-hardening.php:716
msgid "Requires WP 6.2+. Cuts scan cost sharply but misses keywords that appear only in post content"
msgstr ""

#: omni-performance-hardening.php:717
msgid "Non-CJK long string threshold"
msgstr ""

#: omni-performance-hardening.php:717
msgid "Strings longer than this without CJK characters are treated as junk probes; 0 disables"
msgstr ""

#: omni-performance-hardening.php:718
msgid "Skip result count on search"
msgstr ""

#: omni-performance-hardening.php:718
msgid "Skips counting how many posts match the search. Counting them is expensive — the database has to scan every match just to reach a total — but themes need that total to work out how many pages of results exist. Without it no pagination links are drawn and results stop at page one. Off by default; before 1.8.0 it was always on. Turn it on only if visitors never page past the first screen of search results"
msgstr ""

#: omni-performance-hardening.php:719
msgid "Archives & feeds"
msgstr ""

#: omni-performance-hardening.php:720
msgid "Archive posts per page"
msgstr ""

#: omni-performance-hardening.php:720
msgid "Applies to tag, taxonomy, author and date archives. Minimum 1"
msgstr ""

#: omni-performance-hardening.php:721
msgid "Thin tag threshold"
msgstr ""

#: omni-performance-hardening.php:721
msgid "Tag pages with this many posts or fewer are marked noindex; 0 disables"
msgstr ""

#: omni-performance-hardening.php:722
msgid "Deep pagination threshold"
msgstr ""

#: omni-performance-hardening.php:722
msgid "Pages beyond this number are marked noindex; 0 disables"
msgstr ""

#: omni-performance-hardening.php:723
msgid "Feed policy"
msgstr ""

#: omni-performance-hardening.php:723
msgid "Check which feed paths your content partners subscribe to before deploying"
msgstr ""

#: omni-performance-hardening.php:724
msgid "Remove extra feed discovery links"
msgstr ""

#: omni-performance-hardening.php:724
msgid "Also removes category feed discovery links; existing feed URLs keep working"
msgstr ""

#: omni-performance-hardening.php:725
msgid "Tag feed items"
msgstr ""

#: omni-performance-hardening.php:725
msgid "0 leaves the default untouched"
msgstr ""

#: omni-performance-hardening.php:726
msgid "External feed cache hours"
msgstr ""

#: omni-performance-hardening.php:726
msgid "Cache lifetime for fetch_feed() results"
msgstr ""

#: omni-performance-hardening.php:728
msgid "Other"
msgstr ""

#: omni-performance-hardening.php:729
msgid "Frontend external timeout (seconds)"
msgstr ""

#: omni-performance-hardening.php:729
msgid "Cap on external HTTP calls during frontend requests from logged-out visitors"
msgstr ""

#: omni-performance-hardening.php:730
msgid "Editor Heartbeat interval (seconds)"
msgstr ""

#: omni-performance-hardening.php:730
msgid "How often the editor checks for autosaves and post locks. Higher means fewer admin-ajax calls; clamped to 15-300"
msgstr ""

#: omni-performance-hardening.php:731
msgid "List screen Heartbeat interval (seconds)"
msgstr ""

#: omni-performance-hardening.php:731
msgid "Polling interval on post list screens; clamped to 15-300"
msgstr ""

#: omni-performance-hardening.php:819
msgid "Settings saved. Cached pages will reflect changes after the cache expires or is purged."
msgstr ""

#. translators: 1: PH_* 2: wp-config.php
#: omni-performance-hardening.php:827
#, php-format
msgid "Priority: %1$s constants in %2$s > settings on this page > defaults. Fields pinned by a defined constant are locked."
msgstr ""

#: omni-performance-hardening.php:860
msgid "cache — keep all feeds, only add cache headers"
msgstr ""

#: omni-performance-hardening.php:861
msgid "strict — author / search / comment feeds return 410 (default)"
msgstr ""

#: omni-performance-hardening.php:862
msgid "off — keep only the main feed and category feeds"
msgstr ""

